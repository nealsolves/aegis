{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEGIS Audit Artifact",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "audit_schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "canonicalization_profile": {
      "type": "string",
      "const": "aegis-json-v2"
    },
    "policy_file": {
      "type": "string",
      "minLength": 1
    },
    "policy_schema_version": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "model_provider": {
      "type": "string",
      "minLength": 1
    },
    "model_identifier": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "enforcement_result": {
      "type": "string",
      "enum": ["PASS", "FAIL"]
    },
    "failures": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "field": { "type": ["string", "null"] }
        },
        "required": ["code", "message", "field"]
      }
    },
    "failure_gate": {
      "type": ["string", "null"],
      "enum": [null, "invocation_validation", "role_validation", "precondition_validation", "schema_validation", "postcondition_validation", "feature_not_implemented", "tool_validation", "guard_evaluation", "condition_resolution", "sink_emission", "risk_scoring", "custom_gate_violation", "wrapped_function_error"],
      "description": "Which enforcement gate failed (null for PASS results)"
    },
    "failure_reason": {
      "type": ["string", "null"],
      "description": "Human-readable failure reason (null for PASS results)"
    },
    "input_checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "context": {
      "type": "object",
      "maxProperties": 100,
      "properties": {
        "session_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "step_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "step_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workflow_policy_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "participant_id": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {"required": ["step_index"]},
              {"required": ["workflow_policy_digest"]}
            ]
          },
          "then": {
            "required": [
              "session_id",
              "step_id",
              "step_index",
              "workflow_policy_digest"
            ]
          }
        }
      ],
      "description": "Invocation context fields (e.g. session_id, tenant_id) for sink consumers"
    },
    "metadata": {
      "type": "object",
      "maxProperties": 100,
      "properties": {
        "enforcement_mode": {
          "type": "string",
          "enum": ["unified", "split", "split_pre_call_only"],
          "description": "Execution mode used for this artifact"
        },
        "pre_call_gates_evaluated": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 1000,
          "description": "Ordered list of Phase A gates completed"
        },
        "post_call_gates_evaluated": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 1000,
          "description": "Ordered list of Phase B gates completed"
        },
        "pre_call_timestamp": {
          "type": "integer",
          "minimum": 0,
          "description": "Unix epoch seconds when Phase A completed"
        },
        "post_call_timestamp": {
          "type": "integer",
          "minimum": 0,
          "description": "Unix epoch seconds when Phase B completed"
        },
        "stateful_decisions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_version", "provider_contract_version", "provider_id",
              "consistency_domain", "durability_domain", "clock_source",
              "policy_state_id", "constraint_id", "policy_digest", "tool",
              "scope_dimensions", "requested_units", "limit", "window_ms",
              "outcome", "reason_code", "attempt_count",
              "reconciliation_status", "control_state_changed",
              "operation_fingerprint"
            ],
            "properties": {
              "evidence_version": {"const": 1},
              "provider_contract_version": {"const": 1},
              "provider_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "consistency_domain": {"enum": ["instance", "process", "distributed"]},
              "durability_domain": {"enum": ["none", "process_lifetime", "durable"]},
              "clock_source": {"enum": ["monotonic", "coordinated"]},
              "policy_state_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "constraint_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "tool": {"type": "string", "minLength": 1, "maxLength": 128},
              "scope_dimensions": {
                "type": "array", "items": {"enum": ["tenant", "tool"]},
                "minItems": 2, "maxItems": 2, "uniqueItems": true
              },
              "requested_units": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
              "limit": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
              "window_ms": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
              "outcome": {"enum": ["admitted", "denied"]},
              "reason_code": {"type": "string", "minLength": 1, "maxLength": 128},
              "attempt_count": {"type": "integer", "minimum": 1, "maximum": 3},
              "reconciliation_status": {"enum": ["not_required", "reconciled", "failed"]},
              "control_state_changed": {"type": "boolean"},
              "used": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "remaining": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "effective_limit": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
              "retry_after_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "state_version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
              "provider_time_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "provider_record_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "operation_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      },
      "additionalProperties": true
    },
    "risk_score": {
      "type": ["number", "null"],
      "description": "Computed risk score from risk scoring engine"
    },
    "signature": {
      "type": ["string", "null"],
      "description": "Cryptographic signature of the artifact"
    },
    "signature_status": {
      "type": "string",
      "enum": ["signed", "unsigned"]
    },
    "signature_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "signing_profile",
        "canonicalization_version",
        "payload_type",
        "algorithm",
        "signature_encoding",
        "key_reference",
        "key_version",
        "signed_at"
      ],
      "properties": {
        "schema_version": {"type": "string", "const": "1"},
        "signing_profile": {"type": "string", "const": "aegis-signature-v1"},
        "canonicalization_version": {"type": "string", "const": "aegis-canonical-json-v1"},
        "canonicalization_profile": {"type": "string", "const": "aegis-json-v2"},
        "payload_type": {"type": "string", "const": "audit_artifact"},
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$",
          "not": {"pattern": "[^A-Za-z0-9._-]"}
        },
        "signature_encoding": {"type": "string", "enum": ["hex", "base64"]},
        "key_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[\\u0020-\\u007E]+$",
          "not": {"pattern": "[^\\u0020-\\u007E]"}
        },
        "key_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]+$",
          "not": {"pattern": "[^A-Za-z0-9._:/-]"}
        },
        "signed_at": {"type": "integer", "minimum": 0}
      }
    },
    "provenance": {
      "type": ["object", "null"],
      "description": "Workflow provenance metadata supplied by the caller",
      "minProperties": 1,
      "properties": {
        "source_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 1000,
          "description": "Identifiers of source invocations that contributed to this one"
        },
        "derived_from_audit_checksums": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 1000,
          "description": "SHA-256 checksums of prior audit artifacts this invocation derived from"
        },
        "compilation_source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Orchestrator-supplied hash of the raw source compilation set"
        }
      },
      "additionalProperties": false
    },
    "chain_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Audit chain identifier for tamper-evident chaining"
    },
    "chain_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Position in the audit chain"
    },
    "previous_audit_checksum": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$",
      "description": "V2 content checksum of the previous artifact in the chain"
    },
    "reservation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Host-owned identity for the chain placement transaction"
    },
    "checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 v2 content checksum of this artifact"
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {"required": ["chain_id"]},
          {"required": ["chain_index"]},
          {"required": ["previous_audit_checksum"]},
          {"required": ["reservation_id"]}
        ]
      },
      "then": {
        "required": [
          "chain_id",
          "chain_index",
          "previous_audit_checksum",
          "reservation_id"
        ]
      }
    },
    {
      "if": {
        "required": ["chain_index"],
        "properties": {"chain_index": {"const": 0}}
      },
      "then": {
        "properties": {"previous_audit_checksum": {"type": "null"}}
      }
    },
    {
      "if": {
        "required": ["chain_index"],
        "properties": {"chain_index": {"minimum": 1}}
      },
      "then": {
        "properties": {
          "previous_audit_checksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  ],
  "required": [
    "audit_schema_version",
    "canonicalization_profile",
    "policy_file",
    "policy_schema_version",
    "policy_version",
    "model_provider",
    "model_identifier",
    "role",
    "enforcement_result",
    "failures",
    "input_checksum",
    "output_checksum",
    "timestamp",
    "context",
    "metadata",
    "checksum",
    "signature_status",
    "signature"
  ]
}
