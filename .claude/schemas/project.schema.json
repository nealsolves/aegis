{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/project.schema.json",
  "title": "Project control plane",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "control_plane_version",
    "instruction_system",
    "project",
    "delivery",
    "spec_kit",
    "commands",
    "data",
    "environments",
    "remote_actions",
    "production_actions",
    "financial_limits",
    "external_obligations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "control_plane_version": {"type": "integer", "minimum": 1},
    "instruction_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_state"],
      "properties": {
        "module_state": {"enum": ["bootstrapping", "complete"]}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "lifecycle"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "lifecycle": {"enum": ["unconfigured", "configured"]}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_profile", "overlays", "owner", "escalation_owner"],
      "properties": {
        "base_profile": {"enum": ["solo", "team", "prototype"]},
        "overlays": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "owner": {"type": "string", "minLength": 1},
        "escalation_owner": {"type": "string", "minLength": 1}
      }
    },
    "spec_kit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "design_reference", "tested_version", "minimum_version", "allow_equivalent_manual_gates"],
      "properties": {
        "enabled": {"type": "boolean"},
        "design_reference": {"type": "string", "minLength": 1},
        "tested_version": {"type": "string", "minLength": 1},
        "minimum_version": {"type": "string", "minLength": 1},
        "allow_equivalent_manual_gates": {"type": "boolean"}
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "test", "lint", "typecheck", "build", "release"],
      "properties": {
        "install": {"type": "string", "minLength": 1},
        "test": {"type": "string", "minLength": 1},
        "lint": {"type": "string", "minLength": 1},
        "typecheck": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1}
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classifications", "regulated_data", "production_data_in_nonproduction"],
      "properties": {
        "classifications": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "regulated_data": {"type": "string", "minLength": 1},
        "production_data_in_nonproduction": {"enum": ["prohibited", "allowed"]}
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configured"],
      "properties": {
        "configured": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "remote_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "repository", "push_branch", "open_pull_request", "update_pull_request", "merge_pull_request", "create_release"],
      "properties": {
        "enabled": {"type": "boolean"},
        "repository": {"type": "string", "minLength": 1},
        "push_branch": {"type": "boolean"},
        "open_pull_request": {"type": "boolean"},
        "update_pull_request": {"type": "boolean"},
        "merge_pull_request": {"type": "boolean"},
        "create_release": {"type": "boolean"}
      }
    },
    "production_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "target", "deploy", "rollback", "deploy_command", "rollback_command"],
      "properties": {
        "enabled": {"type": "boolean"},
        "target": {"type": "string", "minLength": 1},
        "deploy": {"type": "boolean"},
        "rollback": {"type": "boolean"},
        "deploy_command": {"type": "string", "minLength": 1},
        "rollback_command": {"type": "string", "minLength": 1}
      }
    },
    "financial_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "autonomous_spend"],
      "properties": {
        "currency": {"type": "string", "minLength": 1},
        "autonomous_spend": {"type": "number", "minimum": 0}
      }
    },
    "external_obligations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
